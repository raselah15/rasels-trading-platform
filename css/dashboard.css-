form{

max-width:700px;

background:#161b22;

padding:25px;

border-radius:15px;

}

form input,
form select{

width:100%;

padding:15px;

margin:12px 0;

border:none;

border-radius:10px;

background:#222;

color:white;

font-size:16px;

}

form button{

width:100%;

padding:15px;

margin-top:10px;

background:#00c853;

color:white;

border:none;

border-radius:10px;

font-size:18px;

cursor:pointer;

}

form button:hover{

background:#00e676;

}
